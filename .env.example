# ==========================================
# CONFIGURACIÓN DE PUERTOS EN EL SERVIDOR HOST
# ==========================================
# Cambia estos puertos si chocan con otros contenedores del servidor.
PORT_BACKEND=8005
PORT_FRONTEND_ADMIN=8085
PORT_FRONTEND_PUBLIC=8086

# ==========================================
# VARIABLES DE ENTORNO PARA EL BACKEND (FastAPI)
# ==========================================
# Cadena de conexión a base de datos externa SQL Server.
DATABASE_URL=mssql+pyodbc://tributario:123456789@192.168.20.77:49520/DB_VIALIDAD?driver=ODBC+Driver+17+for+SQL+Server

# Claves de encriptación seguras. Puedes generarlas con: openssl rand -hex 32
SECRET_KEY=9a15f0853503c5b8823f3801f114f09d8544ab67db0732df30b427b3117769cf
REFRESH_SECRET_KEY=3dbf15f6291ea3d8c114cb9128f117a3a93864bb08a113524efb1e8e2d45c61a

ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# URLs externas para CORS y redirecciones (Usan la IP del servidor y el puerto respectivo)
FRONTEND_URL=http://<IP_DEL_SERVIDOR>:8085
VALIDATOR_URL=http://<IP_DEL_SERVIDOR>:8086

# Intentos de Login y Bloqueo
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

# ==========================================
# VARIABLES DE ENTORNO PARA EL FRONTEND (Vite / React)
# ==========================================
# NOTA: Estas URLs se incrustan en el build estático.
# Deben apuntar a la IP del servidor y el puerto público de la API del Backend (8005).
VITE_API_URL_ADMIN=http://<IP_DEL_SERVIDOR>:8005/api
VITE_API_URL_PUBLIC=http://<IP_DEL_SERVIDOR>:8005/api
