PORT=8000
ENVIRONMENT=development

# ⚠️  OBLIGATORIO: El servidor NO arrancará sin estas variables.
# Ajusta el host, puerto, base de datos y credenciales de SQL Server.
# Si usas ODBC Driver 18, añade TrustServerCertificate=yes si el servidor no tiene SSL firmado.
DATABASE_URL=mssql+pyodbc://sa:TuPasswordFuerte123@localhost:1433/BaseReactPythonDb?driver=ODBC+Driver+17+for+SQL+Server

# ⚠️  OBLIGATORIO: Genera claves seguras con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRET_KEY
REFRESH_SECRET_KEY=CAMBIA_ESTA_CLAVE_REFRESH_SECRET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173

# Intentos de Login y Bloqueo
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

# Contraseñas para el seed inicial de usuarios (superadmin y admin)
# ⚠️  CAMBIA ESTOS VALORES antes de ir a producción.
SEED_SUPERADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD_SUPERADMIN
SEED_ADMIN_PASSWORD=CAMBIA_ESTA_PASSWORD_ADMIN
